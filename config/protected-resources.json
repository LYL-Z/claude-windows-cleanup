{
  "schema_version": 2,
  "description": "机器级红线资源清单（第二道闸门）。默认拒绝已把范围限制在 allowed_item_roots 内；本文件确保即使白名单被放宽，这些路径/模式仍然拒绝。",

  "never_touch_roots": [
    { "path": "%WINDIR%", "reason": "Windows 系统目录" },
    { "path": "%ProgramFiles%", "reason": "其他软件安装目录（Claude 的 ProgramFiles 项由 scope.json 单独放行其子目录）" },
    { "path": "%ProgramFiles(x86)%", "reason": "其他软件安装目录" },
    { "path": "%ProgramData%\\Microsoft", "reason": "系统级共享配置" },
    { "path": "%USERPROFILE%\\AppData\\Local\\Microsoft\\Windows\\Explorer", "reason": "资源管理器使用记录" },
    { "path": "%LOCALAPPDATA%\\Google", "reason": "Chrome 共享用户数据" },
    { "path": "%LOCALAPPDATA%\\Microsoft\\Edge", "reason": "Edge 共享用户数据" },
    { "path": "%APPDATA%\\Mozilla", "reason": "Firefox 共享用户数据" },
    { "path": "%APPDATA%\\Opera Software", "reason": "Opera 用户数据" },
    { "path": "%USERPROFILE%\\Documents", "reason": "个人文档" },
    { "path": "%USERPROFILE%\\Desktop", "reason": "桌面文件" },
    { "path": "%USERPROFILE%\\Downloads", "reason": "下载资料" },
    { "path": "%USERPROFILE%\\Pictures", "reason": "个人照片" },
    { "path": "%USERPROFILE%\\Videos", "reason": "个人视频" },
    { "path": "%USERPROFILE%\\Music", "reason": "个人音乐" },
    { "path": "%USERPROFILE%\\.ssh", "reason": "SSH 密钥" },
    { "path": "%USERPROFILE%\\.gitconfig", "reason": "Git 全局配置" },
    { "path": "%USERPROFILE%\\.git-credentials", "reason": "Git 凭据" },
    { "path": "%USERPROFILE%\\.claude", "reason": "Claude Code 全部本地数据" },
    { "path": "%USERPROFILE%\\.claude.json", "reason": "Claude Code 主配置" },
    { "path": "%USERPROFILE%\\.claude\\.credentials.json", "reason": "Claude Code OAuth 凭据" },
    { "path": "%USERPROFILE%\\.claude\\projects", "reason": "Claude Code 项目会话记录（可能含源代码）" },
    { "path": "%USERPROFILE%\\.claude\\memory", "reason": "Claude Code 项目记忆" },
    { "path": "%USERPROFILE%\\.claude\\history.jsonl", "reason": "提示词历史" },
    { "path": "%USERPROFILE%\\.claude\\file-history", "reason": "文件修改快照" },
    { "path": "%USERPROFILE%\\.claude\\shell-snapshots", "reason": "Shell 环境快照" },
    { "path": "%USERPROFILE%\\.claude\\plugins", "reason": "Claude Code 插件" },
    { "path": "%USERPROFILE%\\.claude\\skills", "reason": "Claude Code Skill" },
    { "path": "%USERPROFILE%\\.claude\\agents", "reason": "Claude Code 自定义 Agent" },
    { "path": "%USERPROFILE%\\.claude\\commands", "reason": "Claude Code 自定义命令" },
    { "path": "%USERPROFILE%\\.claude\\plans", "reason": "规划模式任务计划" },
    { "path": "%USERPROFILE%\\.claude\\tasks", "reason": "任务列表" },
    { "path": "%USERPROFILE%\\.claude\\sessions", "reason": "会话状态" },
    { "path": "%USERPROFILE%\\.claude\\todos", "reason": "待办状态" },
    { "path": "%USERPROFILE%\\.claude\\debug", "reason": "调试日志" },
    { "path": "%USERPROFILE%\\.claude\\paste-cache", "reason": "大段粘贴缓存" },
    { "path": "%USERPROFILE%\\.claude\\image-cache", "reason": "图片缓存" },
    { "path": "%USERPROFILE%\\.claude\\uploads", "reason": "附件" },
    { "path": "%USERPROFILE%\\.claude\\backups", "reason": "配置备份" },
    { "path": "%USERPROFILE%\\.claude\\statsig", "reason": "实验/统计缓存" },
    { "path": "%USERPROFILE%\\.claude\\usage-data", "reason": "使用统计" },
    { "path": "%USERPROFILE%\\.claude\\feedback-bundles", "reason": "反馈数据包" },
    { "path": "%APPDATA%\\Anthropic", "reason": "Anthropic 应用配置" },
    { "path": "%APPDATA%\\Claude", "reason": "Claude Desktop 用户数据（登录态/缓存/配置）" },
    { "path": "%APPDATA%\\Clash Verge", "reason": "网络代理配置" },
    { "path": "%LOCALAPPDATA%\\Programs\\DeepSeek Harness", "reason": "DeepSeek Harness" },
    { "path": "%LOCALAPPDATA%\\Programs\\Cursor", "reason": "Cursor" },
    { "path": "%LOCALAPPDATA%\\Programs\\WorkBuddy", "reason": "WorkBuddy" },
    { "path": "%LOCALAPPDATA%\\Programs\\Trae CN", "reason": "Trae" },
    { "path": "%LOCALAPPDATA%\\Programs\\Obsidian", "reason": "Obsidian" },
    { "path": "%LOCALAPPDATA%\\Docker", "reason": "Docker 运行时" },
    { "path": "%LOCALAPPDATA%\\Packages", "reason": "UWP 应用数据" },
    { "path": "%USERPROFILE%\\.vscode", "reason": "VS Code 配置" },
    { "path": "%USERPROFILE%\\.cursor", "reason": "Cursor 配置" },
    { "path": "%USERPROFILE%\\.codex", "reason": "Codex 配置" },
    { "path": "%USERPROFILE%\\.workbuddy", "reason": "WorkBuddy 数据" },
    { "path": "%USERPROFILE%\\Obsidian", "reason": "Obsidian 知识库" }
  ],

  "never_touch_path_patterns": [
    { "pattern": "(^|\\\\)User Data(\\\\|$)", "reason": "浏览器 profile 根" },
    { "pattern": "(^|\\\\)Profiles(\\\\|$)", "reason": "浏览器 profile 集合" },
    { "pattern": "(^|\\\\)Login Data$", "reason": "浏览器密码库" },
    { "pattern": "(^|\\\\)Cookies$", "reason": "浏览器 Cookie 库" },
    { "pattern": "(^|\\\\)Bookmarks$", "reason": "浏览器收藏夹" },
    { "pattern": "(^|\\\\)History$", "reason": "浏览器历史" },
    { "pattern": "(^|\\\\)Web Data$", "reason": "浏览器自动填充数据" },
    { "pattern": "(^|\\\\)Local State$", "reason": "Electron/浏览器加密密钥容器" },
    { "pattern": "(^|\\\\)Network(\\\\|$)", "reason": "Electron/Chromium 网络凭据目录" },
    { "pattern": "(^|\\\\)Local Storage(\\\\|$)", "reason": "浏览器/Electron 本地存储" },
    { "pattern": "(^|\\\\)IndexedDB(\\\\|$)", "reason": "浏览器/Electron 结构化存储" },
    { "pattern": "(^|\\\\)Session Storage(\\\\|$)", "reason": "浏览器/Electron 会话存储" },
    { "pattern": "\\.git(\\\\|$)", "reason": "Git 仓库" },
    { "pattern": "\\.ssh(\\\\|$)", "reason": "SSH 密钥" },
    { "pattern": "(^|\\\\)node_modules(\\\\|$)", "reason": "开发依赖" },
    { "pattern": "(^|\\\\)\\.credentials\\.json$", "reason": "凭据文件" },
    { "pattern": "(^|\\\\)CLAUDE\\.md$", "reason": "项目级 Claude 指令资产" },
    { "pattern": "(^|\\\\)CLAUDE\\.local\\.md$", "reason": "项目级 Claude 本地指令" },
    { "pattern": "(^|\\\\)\\.mcp\\.json$", "reason": "项目级 MCP 配置" },
    { "pattern": "(^|\\\\)settings\\.local\\.json$", "reason": "项目级 Claude 本地设置" },
    { "pattern": "(^|\\\\)projects(\\\\|$)", "reason": "Claude Code 项目会话目录" },
    { "pattern": "(^|\\\\)shell-snapshots(\\\\|$)", "reason": "Claude Code Shell 快照" },
    { "pattern": "(^|\\\\)file-history(\\\\|$)", "reason": "Claude Code 文件快照" }
  ],

  "never_touch_extensions": [".pfx", ".p12", ".pem", ".key", ".kdbx", ".ovpn", ".jks", ".credentials"],

  "notes": [
    "默认拒绝（scope.json 白名单）是第一道闸门；本文件是第二道，只用于给出更精确的拒绝原因。",
    "本 Skill 不读取上述目录内的任何文件内容，只做存在性与归属判断。",
    "本 Skill 不修改 ACL、不 takeown、不改注册表、不改环境变量、不联网。",
    "V1.1 起，config/ 的哈希被计划绑定：白名单或本文件被改动后，旧计划自动失效。"
  ]
}
